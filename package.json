{
  "name": "grok-build",
  "version": "1.0.0",
  "author": "Alex White",
  "private": true,
  "type": "module",
  "main": "dist-shell/shell/main.js",
  "description": "A native macOS workbench for Grok Build using official ACP and structured CLI transports",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "GROK_GUI_ALLOWED_ORIGIN=http://127.0.0.1:5173 GROK_GUI_LAUNCH_TOKEN=development-only-token tsx watch src/server/index.ts",
    "dev:web": "vite",
    "clean": "node scripts/clean-build.mjs",
    "clean:release": "node scripts/clean-release.mjs",
    "build": "npm run clean && npm run build:web && npm run build:server && npm run build:shell",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:shell": "tsc -p tsconfig.shell.json && node scripts/copy-preload.mjs",
    "shell:dev": "npm run build && electron .",
    "mac:app": "npm run build && npm run clean:release && electron-builder --mac --arm64 --dir",
    "mac:replace": "npm run mac:app && node scripts/replace-macos-app.mjs",
    "mac:dmg": "npm run build && npm run clean:release && electron-builder --mac dmg zip --arm64",
    "start": "node dist-server/server/index.js",
    "protocol:record": "node scripts/acp-recording-proxy.mjs --recording-help",
    "architecture": "npm run architecture:boundaries && npm run architecture:unused && npm run architecture:duplicates",
    "architecture:boundaries": "depcruise 'src/**/*.{ts,tsx,cjs}' --config .dependency-cruiser.cjs --output-type err",
    "architecture:unused": "knip",
    "architecture:duplicates": "jscpd src --min-lines 12 --min-tokens 100 --threshold 3 --reporters console",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.shell.json --noEmit",
    "test:segmentation": "node --import tsx --test src/shared/richTextPipeline.segmentation.test.ts",
    "test:task-runtime": "node --import tsx --test 'src/**/*.characterization.test.ts' 'src/**/*.runtime.test.ts' 'src/**/*.store.test.ts' 'src/**/*.patch.test.ts'"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.2.1",
    "@fontsource-variable/noto-serif-sc": "^5.2.10",
    "@lezer/css": "^1.3.4",
    "@lezer/javascript": "^1.5.4",
    "@viz-js/viz": "^3.28.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "es-module-lexer": "^2.3.1",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "highlight.js": "^11.11.1",
    "http-proxy-3": "^1.23.3",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "node-pty": "^1.1.0",
    "parse5": "^7.3.0",
    "qrcode": "^1.5.4",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "smol-toml": "^1.7.0",
    "three": "^0.185.1",
    "unified": "^11.0.5",
    "ws": "^8.21.0",
    "xstate": "^5.32.4",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-tabs": "^1.1.17",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.5",
    "@types/express": "^5.0.6",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "dependency-cruiser": "^18.0.0",
    "dompurify": "^3.4.12",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "i18next": "^26.3.6",
    "jscpd": "^5.0.12",
    "katex": "^0.17.0",
    "knip": "^6.26.0",
    "lucide-react": "^1.24.0",
    "mermaid": "^11.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.9",
    "react-router-dom": "^7.18.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "build": {
    "appId": "com.alexwhite.grokbuild",
    "productName": "Grok Build",
    "asar": true,
    "asarUnpack": [
      "dist/**",
      "dist-server/**",
      "node_modules/**"
    ],
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.mjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "dist-shell/**/*",
      "package.json",
      "!**/*.map",
      "!**/examples/**",
      "!node_modules/katex/src/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "Grok-Build-${version}-macOS-${arch}.${ext}",
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "127.0.0.1": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": false
            },
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": false
            }
          }
        }
      }
    },
    "dmg": {
      "title": "Grok Build ${version}",
      "window": {
        "width": 560,
        "height": 380
      },
      "contents": [
        {
          "x": 160,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
